# Azure Key Vault live specimen
# @defaultSensitive=false
# @plugin(../../packages/plugins/azure-key-vault)
# @initAzure(vaultUrl=$AZURE_KEY_VAULT_URL)
# ---

# This placeholder gets overridden by .env.local, which is gitignored.
# @type=url
AZURE_KEY_VAULT_URL=https://replace-me.vault.azure.net/

# @type=url
PUBLIC_BASE_URL=https://localhost:5043

# @sensitive
DATABASE_URL=azureSecret("database-url")

# @sensitive
STRIPE_SECRET_KEY=azureSecret("stripe-secret-key")