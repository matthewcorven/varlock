@page "/"
@inject IConfiguration Configuration

<PageTitle>Home</PageTitle>

<h1>Blazor Server + Varlock</h1>

<p>This page keeps the example focused: the server host loads Varlock during startup, then a component reads the resulting values from <code>IConfiguration</code>.</p>
<p class="text-muted">Only non-sensitive values are rendered here.</p>

<h2>Non-Sensitive Component Values</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Key</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var key in VarlockKeys)
        {
            <tr>
                <td>@key</td>
                <td><code>@(Configuration[key] ?? "(null)")</code></td>
            </tr>
        }
    </tbody>
</table>

@code {
    // Keep the component output limited to non-sensitive keys.
    private static readonly string[] VarlockKeys = ["APP_NAME", "COMPONENT_MESSAGE"];
}
