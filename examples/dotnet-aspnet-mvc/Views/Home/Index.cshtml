@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>This example keeps the proof narrow: Varlock is added through <code>WebApplicationBuilder</code> and its values flow into MVC alongside normal ASP.NET configuration sources.</p>
</div>

<h2>Configuration Check</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Key</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.ConfigItems)
        {
            <tr>
                <td>@item.Key</td>
                <td><code>@item.Value</code></td>
            </tr>
        }
    </tbody>
</table>
