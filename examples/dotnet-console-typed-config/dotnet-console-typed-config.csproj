<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VarlockEnabled>true</VarlockEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Varlock.Extensions.Configuration/Varlock.Extensions.Configuration.csproj" />
  </ItemGroup>

  <Import Project="../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.props"
          Condition="Exists('../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.props')" />
  <Import Project="../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.targets"
          Condition="Exists('../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.targets')" />

</Project>
