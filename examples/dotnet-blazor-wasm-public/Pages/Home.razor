@page "/"
@using Varlock.Generated @* 👈 Varlock: use generated public-only type *@

<PageTitle>Home</PageTitle>

<h1>Blazor WebAssembly Public Config</h1>

<p>This example shows the build-time public boundary only. The generated type keeps public values and metadata that are safe for the client bundle, while sensitive keys stay out of the emitted C#.</p>

@* 👈 Varlock: display public configuration from the build-time generated type *@
@* The generated public type excludes SECRET_TOKEN entirely, so there is no plaintext client-side surface here. *@
<h2>Client-Safe Public Values</h2>
<p><em>Generated at build time via <code>@@generateTypes(publicOnly=true)</code>. Sensitive keys like
    <code>SECRET_TOKEN</code> are excluded.</em></p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Property</th>
                <th>Env Key</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in VarlockConfigMetadata.PropertyKeys)
            {
                var prop = typeof(VarlockConfig).GetProperty(entry.Key);
                var value = prop?.GetValue(_config)?.ToString() ?? "(null)";
                <tr>
                    <td>@entry.Key</td>
                    <td><code>@entry.Value</code></td>
                    <td><code>@value</code></td>
                </tr>
            }
        </tbody>
    </table>

@code {
    private readonly VarlockConfig _config = new();
}
