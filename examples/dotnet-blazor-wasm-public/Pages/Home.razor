@page "/"
@using Varlock.Generated @* 👈 Varlock: use generated public-only type *@

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@* 👈 Varlock: display public configuration from the build-time generated type *@
<h2>Varlock Configuration (public-only)</h2>
<p><em>Generated at build time via <code>@@generateTypes(publicOnly=true)</code>. Sensitive keys like
    <code>API_KEY</code> are excluded.</em></p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Property</th>
                <th>Env Key</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in VarlockConfigMetadata.PropertyKeys)
            {
                var prop = typeof(VarlockConfig).GetProperty(entry.Key);
                var value = prop?.GetValue(_config)?.ToString() ?? "(null)";
                <tr>
                    <td>@entry.Key</td>
                    <td><code>@entry.Value</code></td>
                    <td><code>@value</code></td>
                </tr>
            }
        </tbody>
    </table>

@code {
    private readonly VarlockConfig _config = new();
}
