<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <PropertyGroup>
    <VarlockEnabled>true</VarlockEnabled>
    <VarlockGeneratedFile>obj/Varlock/VarlockPublicConfig.g.cs</VarlockGeneratedFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.props" Condition="Exists('../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.props')" />
  <Import Project="../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.targets" Condition="Exists('../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.targets')" />

</Project>
