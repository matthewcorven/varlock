<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VarlockEnabled>true</VarlockEnabled>
    <VarlockGeneratedFile>obj/Varlock/VarlockPublicConfig.g.cs</VarlockGeneratedFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/dotnet/Varlock.DotNet/Varlock.DotNet.csproj" />
  </ItemGroup>

  <Import Project="../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.props"
          Condition="Exists('../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.props')" />
  <Import Project="../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.targets"
          Condition="Exists('../../packages/dotnet/Varlock.MSBuild/build/Varlock.MSBuild.targets')" />

</Project>