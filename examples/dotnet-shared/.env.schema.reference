# Shared .NET reference schema
# Cheat sheet for the Varlock .NET initiative.
# This file is intentionally not a buildable example project.
# Scope: only decorators and schema patterns exercised by the checked-in .NET examples today.
# Wider @env-spec surface exists, but this reference stays aligned to the current proof boundary.
# ---

# Root decorator: make committed example values readable unless an item opts into sensitivity.
# @defaultSensitive=false
REFERENCE_APP_NAME=varlock-reference

# Root decorator: generate C# types for server or desktop apps.
# The .NET examples write generated files under obj/Varlock/.
# @generateTypes(lang="cs", path="obj/Varlock/VarlockConfig.g.cs")
REFERENCE_TYPED_NAME=varlock-typed

# Root decorator: publicOnly=true is the proven client-safe boundary for generated C#.
# Sensitive items stay in the schema, but are filtered from the generated public type artifact.
# @generateTypes(lang="cs", path="obj/Varlock/VarlockPublicConfig.g.cs", publicOnly=true)

# Root decorator: the current .NET bridge surfaces this flag as metadata.
# It does not automatically intercept console output or HTTP responses in the runtime packages.
# @preventLeaks=true
REFERENCE_LEAK_POLICY=metadata-only

# Item decorator: use @type when you want deterministic coercion and generated C# typing.
# Common .NET example types today: number, boolean, and url.

# @type=number
HTTP_PORT=4310

# @type=boolean
FEATURE_ENABLED=true

# @type=url
PUBLIC_BASE_URL=https://public.varlock.test

# Item decorator: fail validation when the value resolves to empty or undefined.
# @required
REQUIRED_TOKEN=

# Item decorator: mark secrets so the CLI and integrations can treat them as non-public.
# @sensitive
SECRET_TOKEN=varlock-secret

# Item value pattern: composition is used in the .NET examples, but it is not a decorator.
APP_ENV=staging
BASE_HOST=api.varlock.test
API_BASE_URL=https://${APP_ENV}.${BASE_HOST}
USERS_ENDPOINT=${API_BASE_URL}/users

# Item value pattern: exec() is also not a decorator. The .NET exec example resolves it through the CLI bridge.
# Pair it with @sensitive when the command returns a secret.
# @sensitive
SERVICE_TOKEN=exec(`bun -e "process.stdout.write('varlock-exec-secret')"`)
